        "parameter": [
          {
            "type": "TEMPLATE",
            "key": "javascript",
            "value": "function () {\n  // zg_url of the click being processed only. GTM keeps keys from earlier pushes,\n  // so a plain Data Layer Variable would repeat the last link's URL on button clicks.\n  var dl = window.dataLayer || [];\n  for (var i = dl.length - 1; i >= 0; i--) {\n    if (dl[i] && dl[i].event === 'zg_event') {\n      var u = dl[i].zg_url;\n      if (typeof u !== 'string' || u === '') return undefined;\n      // No email addresses in GA4.\n      return /^mailto:/i.test(u) ? 'mailto' : u;\n    }\n  }\n  return undefined;\n}"
          }
        ]
      }
    ]
